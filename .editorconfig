# 루트에 반드시 배치
root = true

# 공통 설정
[*]
end_of_line = lf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown 설정
# Markdown은 공백 트림 비활성화 (의도된 공백 보존)
[*.md]
trim_trailing_whitespace = false

# Kotlin / KTS 설정
[*.{kt,kts}]
indent_style = space
indent_size = 4
continuation_indent_size = 8

# ktlint 설정 (또는 android)
# @noinspection UndefinedProperty
ktlint_code_style = intellij_idea

# 팀 기준에 맞게 120 등으로 바꿔도 됨 (현재는 비활성화)
max_line_length = off

# ktlint 1.8.0 표준으로 승격된 규칙 중 비활성화할 규칙 지정
# 프로젝트 상황에 따라 when 진입점의 중괄호 강제 규칙을 끕니다
# @noinspection UndefinedProperty
ktlint_standard_when-entry-bracing = disabled

# Compose 등 함수명 예외: 대문자/스크린명 컨벤션 허용
# ktlint 1.x 버전에서 아래 속성으로 주석된 애너테이션의 함수명은 무시
# @noinspection UndefinedProperty
ktlint_function_naming_ignore_when_annotated_with = Composable,Preview,Test

# 필요 시 개별 룰 끄기 (예: 파일명 규칙)
# ktlint_standard_filename = disabled

# Gradle Kotlin 스크립트 설정
[*.gradle.kts]
indent_style = space
indent_size = 4

# XML/Manifest 설정
[*.xml]
indent_style = space
indent_size = 4