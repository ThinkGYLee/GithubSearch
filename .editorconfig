# 루트에 반드시 배치
root = true

# 공통 설정
[*]
end_of_line = lf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown 설정
# Markdown은 공백 트림 비활성화 (의도된 공백 보존)
[*.md]
trim_trailing_whitespace = false

# Kotlin / KTS 설정
[*.{kt,kts}]
indent_style = space
indent_size = 4
continuation_indent_size = 4

# 할당 연산자(=) 이후에 줄바꿈을 수동으로 했을 때, 포매터가 이를 강제로 한 줄로 합치지 않고 허용하도록 설정합니다.
ij_kotlin_assignment_wrap = normal

# IntelliJ Kotlin 포맷터 설정 (Spotless/Ktlint와 일치)
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
ij_kotlin_imports_layout = *, java.**, javax.**, kotlin.**, kotlinx.**
ij_kotlin_name_count_to_use_star_import = 99
ij_kotlin_name_count_to_use_star_import_for_members = 99
ij_kotlin_packages_to_use_import_on_demand = unset
ij_kotlin_continuation_indent_size = 4

# ktlint 설정: ktlint 1.8.0이 지원하는 단일 규칙을 명시해 로컬·CI를 일치시킨다.
ktlint_code_style = ktlint_official
max_line_length = 120

# ktlint 1.8.0 표준으로 승격된 규칙 중 비활성화할 규칙 지정
ktlint_standard_when-entry-bracing = disabled

# Compose 등 함수명 예외: 대문자/스크린명 컨벤션 허용
ktlint_function_naming_ignore_when_annotated_with = Composable,Preview,Test

# 필요 시 개별 룰 끄기 (예: 파일명 규칙)
# ktlint_standard_filename = disabled

# Gradle Kotlin 스크립트 설정
[*.gradle.kts]
indent_style = space
indent_size = 4

# XML/Manifest 설정
[*.xml]
indent_style = space
indent_size = 4
