#!/usr/bin/env sh
# GithubSearch pre-commit hook: run narrow staged-change guards.
set -eu

repo_root=$(git rev-parse --show-toplevel)

run_guard() {
    guard_script="$repo_root/scripts/git-hooks/$1"
    if [ -f "$guard_script" ]; then
        sh "$guard_script"
    fi
}

# Each guard decides whether the staged paths are relevant and otherwise exits
# successfully. Missing guards keep older branches and worktrees usable.
run_guard "run-staged-knowledge-check.sh"
run_guard "run-staged-resource-lint.sh"
